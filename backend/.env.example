# Aegis-IDX Backend Environment Configuration
# Copy this file to .env and configure your values

# Sectors API Key (Required only for live mode)
SECTORS_API_KEY=

# Sectors Base API URL
SECTORS_BASE_URL=https://api.sectors.app/v1

# Default investigation mode (mock | live | cache)
DEFAULT_MODE=mock

# Soft limit for credit management
CREDIT_SOFT_LIMIT=4

# Allowed CORS origins for Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
